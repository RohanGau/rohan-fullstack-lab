    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "react-turnstile": "^1.1.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
